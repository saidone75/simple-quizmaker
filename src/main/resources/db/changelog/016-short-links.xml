<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="016-short-links" author="quizmaker">
        <createTable tableName="short_links">
            <column name="code" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_short_links"/>
            </column>
            <column name="target_path" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_short_links_target"/>
            </column>
        </createTable>
        <rollback><dropTable tableName="short_links"/></rollback>
    </changeSet>
</databaseChangeLog>
