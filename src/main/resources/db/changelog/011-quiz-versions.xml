<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="011-quiz-versions" author="quizmaker">
        <comment>Existing quizzes and submissions start at version 1; earlier edits cannot be reconstructed.</comment>
        <addColumn tableName="quizzes">
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="quiz_submissions">
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <update tableName="quizzes">
            <column name="version" valueNumeric="1"/>
        </update>
        <update tableName="quiz_submissions">
            <column name="version" valueNumeric="1"/>
        </update>
        <rollback>
            <dropColumn tableName="quiz_submissions" columnName="version"/>
            <dropColumn tableName="quizzes" columnName="version"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
